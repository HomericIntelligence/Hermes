# Containerfile for hermes-ci — CI image for Hermes.
#
# Provides:
# - Python 3.13 base + pixi v0.70.2 (pinned release, checksum-verified)
# - gitleaks 8.30.1 (secrets scan)
# - Non-root user 'ci' (uid 1000) for rootless Podman compatibility
#
# The locked pixi project environment is NOT baked in: the repo is mounted at
# /workspace at runtime and the env lives under /workspace/.pixi (gitignored).
# run_ci_local.sh mounts a persistent host pixi cache (~/.cache/pixi) so
# 'pixi install --locked' is fast on warm runs.
#
# Build (OCI-compliant — works with both podman and docker):
#   podman build --ignorefile ci/.dockerignore -f ci/Containerfile -t hermes-ci:local .
#   docker build -f ci/Containerfile -t hermes-ci:local .

# ============================================================================
# Stage 0: pixi binary — pinned GitHub release, checksum-verified
# ============================================================================
FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91 AS pixi

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL --retry 5 --retry-all-errors https://github.com/prefix-dev/pixi/releases/download/v0.70.2/pixi-x86_64-unknown-linux-musl.tar.gz -o /tmp/pixi.tar.gz \
    && echo "9d0d72fc1fa1a8f87bfde943cf25d3575cb352cb516795d4dab21898bd98adea  /tmp/pixi.tar.gz" | sha256sum --check \
    && tar xzf /tmp/pixi.tar.gz -C /usr/local/bin \
    && rm /tmp/pixi.tar.gz \
    && pixi --version

# ============================================================================
# Stage 1: Runtime — minimal image
# ============================================================================
FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91

LABEL org.opencontainers.image.title="hermes-ci"
LABEL org.opencontainers.image.description="CI container for Hermes — linting, testing, security scans"
LABEL org.opencontainers.image.vendor="Hermes"
LABEL org.opencontainers.image.source="https://github.com/HomericIntelligence/Hermes"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    make \
    jq \
    yamllint \
    shellcheck \
    just \
    docker-cli \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pixi /usr/local/bin/pixi /usr/local/bin/pixi

# gitleaks (secrets scan) — same pin as the workflow (GITLEAKS_VERSION 8.30.1)
RUN curl -sSfL --retry 5 --retry-all-errors https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz \
    | tar -xz -C /usr/local/bin gitleaks \
    && gitleaks version

# nats-server (integration tests need a live broker; pin matches Scylla)
RUN curl -fsSL --retry 5 --retry-all-errors https://github.com/nats-io/nats-server/releases/download/v2.10.24/nats-server-v2.10.24-linux-amd64.tar.gz -o /tmp/nats.tar.gz \
    && echo "ee6500f364e3a741b496ae0296c04f2a9d53bbaabac457104ac74596b4a59d85  /tmp/nats.tar.gz" | sha256sum --check \
    && tar xzf /tmp/nats.tar.gz -C /usr/local/bin --strip-components=1 nats-server-v2.10.24-linux-amd64/nats-server \
    && rm /tmp/nats.tar.gz

# docker compose plugin (docker-compose-config pre-commit hook)
RUN mkdir -p /usr/libexec/docker/cli-plugins \
    && curl -fsSL --retry 5 --retry-all-errors https://github.com/docker/compose/releases/download/v5.4.0/docker-compose-linux-x86_64 -o /usr/libexec/docker/cli-plugins/docker-compose \
    && echo "837fd1d35bf6a494f41b5b5988269a7be79de337cf1a1a6ff0e45ab51bb4e9be  /usr/libexec/docker/cli-plugins/docker-compose" | sha256sum --check \
    && chmod +x /usr/libexec/docker/cli-plugins/docker-compose

# Create non-root user for rootless Podman compatibility
RUN groupadd -r ci && useradd -r -g ci -u 1000 -m -s /bin/bash ci \
    && mkdir -p /home/ci/.cache \
    && chown -R ci:ci /home/ci

WORKDIR /workspace

USER ci
